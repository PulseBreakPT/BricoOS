# =============================================================================
# Brico2 — Template de variáveis de produção
# =============================================================================
# O hostinger-setup.sh gera automaticamente deploy/.env.production com
# segredos seguros. Este ficheiro serve só de documentação/template.
# NUNCA fazer commit do .env.production real.
# =============================================================================

APP_ENV=production

# Domínio público do site (o DNS tem de apontar para o VPS).
SITE_DOMAIN=lusorae.pt
# Email para os certificados Let's Encrypt.
ACME_EMAIL=eu@exemplo.pt

# --- MongoDB (rede interna Docker; sem porta exposta ao host) ---------------
MONGO_INITDB_ROOT_USERNAME=brico2_admin
MONGO_INITDB_ROOT_PASSWORD=troca-por-um-segredo-forte
MONGO_URL=mongodb://brico2_admin:troca-por-um-segredo-forte@mongo:27017/?authSource=admin
DB_NAME=brico2
BACKEND_PORT=8001

# --- API ----------------------------------------------------------------------
CORS_ORIGINS=https://lusorae.pt
# Base pública usada no redirect OAuth do Gmail.
PUBLIC_BASE_URL=https://lusorae.pt

# --- Gmail (opcional) ---------------------------------------------------------
# Cria credenciais OAuth em https://console.cloud.google.com/apis/credentials
# Tipo: "Aplicação Web". Redirect URI autorizado:
#   https://lusorae.pt/api/oauth/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- IA (opcional) -------------------------------------------------------------
OPENAI_API_KEY=
AI_MODEL=gpt-5.4

# Arquivar automaticamente pedidos inativos há mais de N meses.
AUTO_CLOSE_MONTHS=6
